  "objectives": {
    "goal": "capital_preservation_and_growth",
    "risk_level": "medium",
    "max_drawdown_pct": 0.08,
    "max_weight_per_asset": 0.25,
    "min_cash_pct": 0.10,
    "transaction_cost_pct": 0.0005,
    "max_rebalance_pct": 0.20
  },
  "strategy": {
    "type": "momentum_vol_targeting",
    "lookback_days": 40,
    "vol_target": 0.15,
    "momentum_weight": 0.65,
    "vol_weight": 0.35
  },
  "execution": {
    "weight_threshold": 0.025,
    "min_trade_notional_usd": 400,
    "signal_refresh_minutes": 1440,
    "macro_refresh_minutes": 60,
    "circuit_breaker_forced_days": 1,
    "rebalance_cooldown_minutes": 720,
    "max_turnover_pct_per_rebalance": 0.20,
    "stale_price_skip_minutes": 60,
    "stale_abort_ratio": 0.5,
    "max_stale_ratio": 0.3,
    "fill_gap_max": 0.03,
    "fill_gap_max_iters": 2,
    "allow_buy_benchmarks": false,
    "cross_section_top_n": 10,
    "correlation_lookback_days": 60,
    "correlation_threshold": 0.8,
    "volatility_floor": 0.08,
    "min_holding_cycles": 4,
    "allow_high_conviction_override": true,
    "enable_high_conviction_weighting": true,
    "max_high_conviction_weight": 0.4,
    "enable_short_term_momentum": true,
    "short_momentum_lookback_days": 10,
    "enable_exit_signals": true,
    "exit_signal_lookback_days": 20,
    "exit_signal_action": "reduce",
    "exit_signal_reduce_factor": 0.5,
    "exit_signal_min_trigger_count": 1,
    "exit_signal_gap_down_pct": 0.03,
    "exit_signal_volume_spike_ratio": 2.0,
    "exit_signal_consecutive_down_days": 3,
    "exit_signal_long_upper_shadow_ratio": 2.0,
    "enable_score_smoothing": true,
    "score_smoothing_window": 3,
    "max_portfolio_volatility": 0.25,
    "enable_diversity_check": true,
    "max_herfindahl_index": 0.35,
    "portfolio_vol_min_coverage": 0.70,
    "momentum_weights": {
      "short": 0.4,
      "medium": 0.6
    },
    "price_stale_policy": {
      "allow_buy": ["LIVE", "RECENT"],
      "allow_sell": ["LIVE", "RECENT", "STALE"]
    }
  },
  "benchmarks": {
    "tickers": ["QQQ", "SPY", "VTI", "DIA"],
    "evaluation_days": 10
  },
  "regime_filter": {
    "enabled": true,
    "ma_window": 50,
    "trend_score_risk_on": 0.75,
    "trend_score_risk_off": 0.50,
    "cash_risk_on": 0.10,
    "cash_neutral": 0.15,
    "cash_risk_off": 0.25,
    "max_weight_risk_off": 0.20
  },
  "macro_integration": {
    "enabled": true,
    "chroma_path": "./memory_db",
    "collection": "trading_signals",
    "confirm_k_of_n": [2, 3],
    "signal_max_age_hours": 48,
    "decay_lambda_per_hour": 0.15,
    "macro_cash_slope": 0.02,
    "tilt_max_delta": 0.02,
    "enable_llm_topic_signals": true,
    "llm_topic_confidence_threshold": 0.6,
    "llm_topic_score_threshold": 0.5,
    "llm_topic_tilt_scale": 0.02,
    "topic_sector_ticker_map": {
      "semiconductors": ["NVDA", "XLK"],
      "technology": ["XLK", "MSFT", "AAPL"],
      "utilities": ["NEE", "DUK"],
      "energy": ["XOM", "CVX", "XLE"],
      "defense": ["LMT", "RTX"],
      "healthcare": ["XLV", "JNJ", "MRK"],
      "financials": ["XLF", "JPM", "V"]
    },
    "macro_allow_new_positions": ["TLT", "GLD"],
    "smoothing_window": 3,
    "smoothing_method": "median",
    "ewma_alpha": 0.4,
    "cooldown_cycles": 2
  },
  "macro_mapping": {
    "risk_off": {
      "cash_add": 0.10,
      "tilt": {
        "TLT": 0.02,
        "GLD": 0.02
      },
      "cap_equity_delta": -0.02
    },
    "oil_bullish": {
      "tilt": {
        "XOM": 0.02
      }
    },
    "usd_strong": {
      "cash_add": 0.05
    }
  },
  "reporting": {
    "equity_curve_path": "outputs/equity_curve.png",
    "trades_log_path": "outputs/paper_trades.csv",
    "portfolio_snapshots_path": "outputs/portfolio_snapshots.jsonl",
    "summary_report_path": "outputs/paper_summary.txt",
    "scoreboard_path": "outputs/scoreboard.jsonl"
  },
  "safety": {
    "no_real_broker": true,
    "simulation_only": true,
    "random_seed": 42
  }
}
