# If you want to keep outputs/Daily Report/*.json tracked, comment the line above
# and instead ignore only heavy subfolders you don't commit.

# =========================
# scripts/ should be committed, but ignore junk inside
# =========================
scripts/**/__pycache__/
scripts/**/.pytest_cache/
scripts/**/.mypy_cache/
scripts/**/.ruff_cache/

# Generated test outputs inside scripts tree
scripts/**/outputs/
scripts/**/output/
scripts/**/artifacts/
scripts/**/ci_artifacts/

memory_db/
backup/


# Any scratch dirs you might have
scripts/**/tmp/
scripts/**/temp/
scripts/**/.tmp/

